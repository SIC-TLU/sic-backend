# Server config
PORT=your_port
HOST=your_host

# Frontend URL
FRONTEND_URL=your_frontend_url

# Account admin
ADMIN_EMAIL=your_admin_email
ADMIN_USERNAME=your_admin_username
ADMIN_PHONE=your_admin_phone
ADMIN_PASSWORD=your_admin_password

# Roles
ROLE_USER=your_role_user
ROLE_CLUBMEMBER=your_role_clubmember
ROLE_CLUBCOMMITTEHEADS=your_role_clubcommitteheads
ROLE_ADMIN=your_role_admin
ROLE_SUPERADMIN=your_role_superadmin

# Database
MONGODB_URI=your_mongodb_uri

# Config JWT
JWT_SECRET=your_jwt_secret
JWT_ACCESS_TOKEN_EXPIRES_IN=your_jwt_access_token_expired
JWT_REFRESH_TOKEN_EXPIRES_IN=your_jwt_refresh_token_expired

# Config Email
MAIL_USER=your_mail_user
MAIL_PASSWORD=your_mail_password

# Redis
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
